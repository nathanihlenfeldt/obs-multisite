# multisite-player.service — the campus receive appliance.
#
# Starts on power-up and restarts on failure. A campus box that needed
# somebody to log in and start it after a power cut would not be an appliance,
# and the failure would be discovered five minutes before a service.

[Unit]
Description=Multisite campus player
Documentation=https://github.com/nathanihlenfeldt/obs-multisite
# The clock matters: every time this box reports comes from it, and a
# timeline drawn against a wrong clock is worse than none.
After=network-online.target time-sync.target
Wants=network-online.target

# A box that fails to start must keep trying rather than give up after a few
# attempts: the usual cause is a network that has not come up yet, or a USB
# SSD that has not been noticed, and both fix themselves. This is a [Unit] key:
# systemd ignores it in [Service] and says so in the journal.
StartLimitIntervalSec=0

# tty1 can only have one owner. Raspberry Pi OS Lite starts a login prompt on
# it, and the two then take it in turns to hang up on each other: the player
# gets SIGHUP, dies, restarts three seconds later, and evicts the login prompt
# again. Claiming tty1 exclusively is what stops that.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
ExecStart=/usr/local/bin/multisite-player --config /etc/multisite-player/config.json

# Runs as root deliberately, and this is the one place it matters. The player
# has to become DRM master to own the HDMI output, drive ALSA, and set the
# system clock through timedatectl. Dropping to an unprivileged user means
# either a box that cannot show a picture or a pile of polkit rules that break
# on the next distribution upgrade — for a single-purpose appliance on a
# church network, neither is a better trade.
User=root

Restart=always
RestartSec=3

# The console must not draw over the picture the player is putting on screen.
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
StandardInput=tty-force
TTYReset=yes
TTYVHangup=yes

# The segment cache lives here and is deliberately kept across reboots, so a
# restart mid-service resumes rather than starting again.
StateDirectory=multisite-player
ConfigurationDirectory=multisite-player
ConfigurationDirectoryMode=0700

[Install]
WantedBy=multi-user.target
